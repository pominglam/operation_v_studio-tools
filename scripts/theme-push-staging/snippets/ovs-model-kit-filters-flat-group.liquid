{% comment %} Flat filter group. Accepts: group_label, group_id_slug, options_csv, input_class, data_attr, selected_padded, ovs_mk_section_id, ovs_mk_filter_suffix {% endcomment %}
{%- assign ovs_mk_section_id = ovs_mk_section_id | default: section_id | default: collection.id -%}
{%- assign ovs_mk_filter_suffix = ovs_mk_filter_suffix | default: filter_suffix | default: '' -%}<details class="facets__disclosure-vertical js-filter ovs-mk-filters" id="OvsMk{{ group_id_slug }}-{{ ovs_mk_section_id }}{{ ovs_mk_filter_suffix }}" open>
  <summary class="facets__summary caption-large focus-offset">
    <div><span class="facets__summary-label">{{ group_label }}</span>{{- 'icon-caret.svg' | inline_asset_content -}}</div>
  </summary>
  <div class="facets__display-vertical">
    <fieldset class="facets-wrap facets-wrap-vertical">
      <legend class="visually-hidden">{{ group_label }}</legend>
      <ul class="facets-layout facets-layout-list facets-layout-list--text facets__list--vertical list-unstyled" role="list">
        {%- assign option_rows = options_csv | split: ',' -%}
        {%- for option_row in option_rows -%}
          {%- assign option_parts = option_row | split: '|' -%}
          {%- assign option_key = option_parts[0] -%}
          {%- assign option_label = option_parts[1] -%}
          {%- assign option_token = ',' | append: option_key | append: ',' -%}
          <li class="list-menu__item facets__item">
            <label for="OvsMk{{ group_id_slug }}-{{ option_key }}-{{ ovs_mk_section_id }}{{ ovs_mk_filter_suffix }}" class="facets__label facet-checkbox">
              <input type="checkbox" id="OvsMk{{ group_id_slug }}-{{ option_key }}-{{ ovs_mk_section_id }}{{ ovs_mk_filter_suffix }}" class="{{ input_class }}" value="{{ option_key }}" {{ data_attr }}="{{ option_key }}" {% if selected_padded contains option_token %}checked{% endif %}>
              {{- 'square.svg' | inline_asset_content -}}
              <div class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</div>
              <span class="facet-checkbox__text" aria-hidden="true"><span class="facet-checkbox__text-label">{{ option_label }}</span></span>
            </label>
          </li>
        {%- endfor -%}
      </ul>
    </fieldset>
  </div>
</details>
