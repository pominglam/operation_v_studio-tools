APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
TRACKING_SCRAPER_URL=http://tracking_scraper:3002

# Shopify ERP (Dev Dashboard OAuth — Admin token in `shopify_oauth_installations` + webhook ingress)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=
SHOPIFY_OAUTH_SCOPES=read_locations,read_products,read_inventory,read_orders,read_all_orders,read_customers,read_collections,read_publications,read_online_store_navigation,write_products,write_inventory,write_publications,write_online_store_navigation,write_themes,write_customers,write_draft_orders,read_draft_orders
# Custom Asia Shopify invoices need write_draft_orders (+ write_customers to create customers). Re-OAuth after changing scopes.
# PO "Push qty" / Export to Shopify need write_products + write_inventory; all sales channels need read_publications + write_publications
# SHOPIFY_INVENTORY_LOCATION_GID=gid://shopify/Location/123456789
# Latest Arrivals smart collection (manual sort) — reorder after PO push
# SHOPIFY_LATEST_ARRIVALS_COLLECTION_GID=gid://shopify/Collection/123456789
# tuning (optional)
# SHOPIFY_GRAPHQL_TIMEOUT=120
# SHOPIFY_GRAPHQL_PAGE_SIZE=50
# SHOPIFY_INVENTORY_ITEM_BATCH_SIZE=200
# SHOPIFY_GRAPHQL_RETRY_ATTEMPTS=3
# SHOPIFY_GRAPHQL_RETRY_SLEEP_MS=250
# SHOPIFY_THEME_MIRROR_PATH=
# Model-kit storefront index cache (themeFilesUpsert). Default live Rise + AI Dev.
# SHOPIFY_MK_INDEX_REBUILD_ENABLED=true
# SHOPIFY_MK_INDEX_THEME_IDS=190542250065,196218716241
# SHOPIFY_MK_INDEX_POKE_DELAY_SECONDS=8
# SHOPIFY_MK_INDEX_FILENAME=snippets/ovs-model-kit-index-cache.liquid
# SHOPIFY_LOG_LEVEL=info
# Shared inboxes that must not join two customers (comma-separated)
# SHOPIFY_CUSTOMER_EMAIL_DENYLIST=
# Absolute path to ovs-shopify-theme (manifest generate, filter verify). Defaults to ../ovs-shopify-theme.
# OVS_SHOPIFY_THEME_PATH=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Database backups (scheduler + retention — see docs/requirements/maintenance-db-backups.md)
DB_BACKUP_SCHEDULE_ENABLED=true
DB_BACKUP_HOST_ORCHESTRATOR=true
DB_BACKUP_SCHEDULE_TIME=02:30
DB_BACKUP_PURGE_TIME=03:30
DB_BACKUP_RETENTION_RECENT_DAYS=14
DB_BACKUP_RETENTION_WEEKLY_DAYS=180
DB_BACKUP_RETENTION_MINIMUM=5
